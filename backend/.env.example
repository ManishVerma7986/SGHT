PORT=5000
FRONTEND_URL=http://localhost:5173

# Oracle Autonomous Database
DB_USER=SHGT_RUNTIME
DB_PASSWORD=YOUR_RUNTIME_PASSWORD
DB_CONNECT_STRING=shgtdb_low
DB_WALLET_LOCATION=./config/oracle-wallet
DB_WALLET_PASSWORD=YOUR_WALLET_PASSWORD

PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# use backend\scripts\provision-hmac-key.js to generate HMAC key.
# create a env.provision and add DB_USER=SHGT_APP, DB_PASSWORD=YOUR_APP_PASSWORD and run this command
# node -e "require('dotenv').config({path:'backend/.env'}); const k=process.env.SHGT_BACKEND_HMAC_KEY; console.log('HMAC key configured:', /^[0-9a-fA-F]{64}$/.test(k || ''));"
SHGT_BACKEND_HMAC_KEY=auto maticallygenerated