# Copy to .env.development and provide development-only values.
# Select this profile in the process environment before starting the backend:
# $env:SHGT_DEPLOYMENT_PROFILE = "development"
# Never copy production credentials or the production HMAC key.

PORT=5001
FRONTEND_URL=http://localhost:5173

DB_USER=SHGT_DEV_RUNTIME
DB_PASSWORD=DEVELOPMENT_ORACLE_PASSWORD
DB_CONNECT_STRING=DEVELOPMENT_CONNECT_IDENTIFIER
DB_WALLET_LOCATION=./config/oracle-wallet-dev
DB_WALLET_PASSWORD=DEVELOPMENT_WALLET_PASSWORD

PRIVY_APP_ID=DEVELOPMENT_PRIVY_APP_ID
PRIVY_APP_SECRET=DEVELOPMENT_PRIVY_APP_SECRET

# Supply an independently generated 32-byte development key as 64 hex characters.
SHGT_BACKEND_HMAC_KEY=REPLACE_WITH_DEVELOPMENT_ONLY_KEY
